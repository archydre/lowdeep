{
  "name": "lowdeep",
  "version": "1.2.0",
  "description": "The fluent, resilient, and 100% Type-Safe AI SDK with Self-Healing logic.",
  "keywords": [
    "ai",
    "openai",
    "groq",
    "zod",
    "type-safe",
    "builder"
  ],
  "homepage": "https://github.com/archydre/lowdeep#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archydre/lowdeep.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build ./src/index.ts --outdir ./dist --target node --sourcemap=linked --external openai --external zod && bun build ./src/index.ts --outdir ./dist --target node --format cjs --sourcemap=linked --external openai --external zod --entry-naming \"[name].cjs\" && tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:beta": "npm version prerelease --preid=beta",
    "publish:stable": "npm publish",
    "publish:beta": "npm publish --tag beta"
  },
  "author": "Zaqueu Nilton de Souza Paiva <zaqueunilton1@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "openai": "^6.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
